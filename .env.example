# Mithqal — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ---- Database (Turso libsql — persistent across Vercel cold starts) ----
# Get these from https://app.turso.tech → your database → Settings
# DATABASE_URL is the libsql:// connection string
# DATABASE_AUTH_TOKEN is the database auth token (NOT the Turso API token)
# For local dev, use file:./db/custom.db (no auth token needed)
DATABASE_URL=libsql://mithqal-db-fortleem.aws-us-east-1.turso.io
DATABASE_AUTH_TOKEN=your-turso-database-auth-token

# ---- NextAuth (Admin console authentication) ----
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ---- Operator account (env-defined — no user table) ----
ADMIN_EMAIL=coo@mithqal.io
# scrypt hash of the operator password, format: saltHex:hashHex
# Generate with:
#   node -e "const {scryptSync,randomBytes}=require('crypto');const p=process.argv[1];const s=randomBytes(16);const h=scryptSync(p,s,64);console.log(s.toString('hex')+':'+h.toString('hex'))" 'YOUR_PASSWORD'
ADMIN_PASSWORD_HASH=

# ---- Email notifications (Formation Committee submissions → operator) ----
ADMIN_NOTIFY_EMAIL=meltonsy@icloud.com

# ---- SMTP: Apple iCloud (smtp.mail.me.com:587 + STARTTLS) ----
# Configured 2026-07-26 per COO direction.
# Port 587 uses STARTTLS (forced via requireTLS:true in src/lib/email.ts).
# Port 465 uses implicit TLS (secure:true).
# For iCloud: use an App-Specific Password (NOT the Apple ID password):
#   https://account.apple.com → Sign-In & Security → App-Specific Passwords
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=meltonsy@icloud.com
SMTP_PASS=your-icloud-app-specific-password
SMTP_FROM="Mithqal <noreply@mithqal.io>"
