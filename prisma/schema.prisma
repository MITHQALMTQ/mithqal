// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// When using the libsql driver adapter, the datasource URL is only used by
// Prisma's internal validation — the actual connection is handled by the
// adapter in src/lib/db.ts (which reads DATABASE_URL for the real Turso URL).
datasource db {
  provider = "sqlite"
  url      = "file:./prisma.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Public Formation Committee interest capture — the credibility-layer intake
// for investors, advisors, anchor participants and Council nominees.
model FormationInterest {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  org       String?
  role      String   // investor | advisor | anchor | council-nominee | partner | other
  message   String?
  createdAt DateTime @default(now())

  @@index([role])
  @@index([createdAt])
}

// MTQ testnet simulator — append-only ledger of mint/redeem operations.
// State (supply, reserves by tier, NAV, reserve ratio) is derived from this
// immutable log on every read. This mirrors the Constitution's own
// auditability principle: every claim verifiable from the ledger.
model TestnetOperation {
  id           String   @id @default(cuid())
  type         String   // mint | redeem
  amountUsd    Float    // USD value of the deposit (mint) or claim (redeem)
  mtq          Float    // MTQ minted or burned
  participant  String   // label for the simulated participant
  nav          Float    // NAV (USD per MTQ) at time of op
  reserveRatio Float    // reserve ratio (%) after op
  porHash      String   // proof-of-reserves hash after op
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([type])
}

// === v25.8 Architectural Models (per F1 gap analysis) ===
//
// These four models close architectural gap #1 from the F1 cross-reference
// (commit 98a22ed): the institutional-grade surface area required by the
// v25.3 Master Blueprint needs persistent records of (1) the banks /
// custodians / clearing-houses / central-banks that interact with MITHQAL,
// (2) the individual reserve holdings backing MTQ issuance (per Constitution
// v19.0 §22 multi-currency backing), (3) the AML / KYC / sanctions / PEP /
// adverse-media screening records produced for each counterparty, and (4)
// the Council governance proposals per Constitution v19.0 §41-§44.
//
// Architectural constraint: these are NEW tables that sit ALONGSIDE the
// existing User / Post / FormationInterest / TestnetOperation models. They
// do NOT add foreign-key relationships to those existing models — the
// deterministic v19 monetary engine (src/lib/monetary-engine-v19.ts,
// src/lib/nav-compute.ts, src/lib/fixed-point.ts) continues to use the
// libsql client directly (per src/lib/db.ts) with its own schema. These
// v25.8 models are persisted both via Prisma migrate/db:push (into
// prisma/prisma.db for Prisma Studio introspection) AND via the
// `ensureV258Schema()` CREATE TABLE IF NOT EXISTS statements in src/lib/db.ts
// (into the runtime libsql database) so the new API routes
// (/api/bank-participants, /api/reserve-holdings,
// /api/compliance-screenings, /api/governance-proposals) work end-to-end
// in the running dev server today — even if the global `__schemaInitialized`
// flag was already true (which would otherwise short-circuit ensureSchema()
// and skip the new tables).
//
// Decimal is used for all monetary fields (quantity, marketValueUsd) per
// Prisma-faithful schema. SQLite has no native Decimal type — Prisma stores
// Decimal as REAL (Float64) under the hood in prisma.db. To avoid REAL
// precision loss in production monetary flows, the runtime libsql CREATE
// TABLE counterparts in src/lib/db.ts use TEXT columns + string transport
// (the same BigDecimal-safe pattern the existing `transactions.amount` and
// `fees.amount` columns use). The TS interface fields exposed to callers
// are typed as `string` so callers stay BigDecimal-safe end-to-end.

model BankParticipant {
  id              String   @id @default(cuid())
  legalName        String   @unique
  swiftCode        String?  @unique
  jurisdiction     String   // ISO 3166-1 alpha-2 country code
  participantType  String   // bank | custodian | clearing-house | central-bank
  regulatoryId     String?  // license/registration number
  onboardedAt      DateTime @default(now())
  onboardedBy      String?  // operator who approved
  status           String   @default("pending")  // pending | approved | suspended | revoked
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  kycStatus        String   @default("not-started")  // not-started | in-progress | verified | rejected
  amlStatus        String   @default("not-started")
  sanctionsStatus  String   @default("not-started")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reserveHoldings      ReserveHolding[]
  complianceScreenings ComplianceScreening[]

  @@index([status])
  @@index([participantType])
  @@index([jurisdiction])
  @@index([createdAt])
}

model ReserveHolding {
  id              String   @id @default(cuid())
  bankParticipantId String?
  assetClass       String   // gold | silver | sovereign | stablecoin | cash
  assetSymbol      String   // XAU | XAG | US-TREASURY-10Y | USDC | USD
  custodyLocation String?  // vault / DLT address / chain
  quantity         Decimal  // stored as REAL (SQLite has no native Decimal type)
  unit             String   // oz | usd | token | gram
  marketValueUsd   Decimal  // stored as REAL (SQLite has no native Decimal type)
  haircutBps       Int      @default(0)  // basis points
  verifiedAt       DateTime?
  verifiedBy       String?
  verificationHash String?  // hash of independent verification
  status           String   @default("pending")  // pending | verified | rejected | frozen
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bankParticipant  BankParticipant? @relation(fields: [bankParticipantId], references: [id])

  @@index([assetClass])
  @@index([assetSymbol])
  @@index([status])
  @@index([createdAt])
  @@index([verifiedAt])
}

model ComplianceScreening {
  id              String   @id @default(cuid())
  bankParticipantId String?
  screeningType    String   // aml | kyc | sanctions | pep | adverse-media
  screeningProvider String?  // chainalysis | elliptic | refinitiv | internal
  inputValue       String   // entity screened
  inputType        String   // individual | entity | transaction
  result           String   // clear | hit | review | escalated
  riskScore        Int?     // 0-100
  matchCount       Int      @default(0)
  matchedEntities  String?  // JSON array of matched entities
  screenedAt       DateTime @default(now())
  screenedBy       String?  // operator
  expiresAt        DateTime?  // screenings expire after 90 days
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bankParticipant  BankParticipant? @relation(fields: [bankParticipantId], references: [id])

  @@index([screeningType])
  @@index([result])
  @@index([screenedAt])
  @@index([expiresAt])
}

model GovernanceProposal {
  id              String   @id @default(cuid())
  proposalType    String   // parameter-change | emergency-action | council-nomination | constitutional-amendment
  title           String
  description     String
  proposerAddress String   // wallet address of proposer
  proposerRole    String   // council-member | operator | external
  proposalHash    String   @unique  // hash of proposal content for integrity
  actionsJson     String   // JSON array of proposed actions
  status          String   @default("draft")  // draft | proposed | active | passed | rejected | executed | expired
  quorumRequired  Int      @default(5)  // min votes for quorum
  approvalRequired Int     @default(4)  // min approvals to pass (4-of-7)
  maxSeverity     String   @default("low")  // low | medium | high | critical
  validUntil      DateTime  // expiry timestamp
  proposedAt      DateTime @default(now())
  votingOpensAt   DateTime?
  votingClosesAt  DateTime?
  executedAt      DateTime?
  executedBy      String?
  executionTxHash String?  // on-chain tx hash if executed via council action
  approvalsJson   String   @default("[]")  // JSON array of {address, signedAt, role}
  rejectionsJson  String   @default("[]")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([proposalType])
  @@index([proposedAt])
  @@index([validUntil])
  @@index([proposerAddress])
}